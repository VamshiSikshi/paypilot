# Razorpay OAuth credentials
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_REDIRECT_URI=
RAZORPAY_OAUTH_SCOPE=

# OAuth configuration
RAZORPAY_OAUTH_AUTHORIZATION_URI=https://auth.razorpay.com/authorize
RAZORPAY_OAUTH_TOKEN_URI=https://auth.razorpay.com/token
RAZORPAY_OAUTH_MODE=test

# Token encryption
# Generate a secure 32-byte key and Base64-encode it.
RAZORPAY_TOKEN_ENCRYPTION_KEY_BASE64=
RAZORPAY_TOKEN_ENCRYPTION_KEY_VERSION=v1

# JWT signing secret — set a strong secret locally
PAYPILOT_JWT_SECRET=
PAYPILOT_JWT_EXPIRATION=86400000
PAYPILOT_JWT_ISSUER=paypilot